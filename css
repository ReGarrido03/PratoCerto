@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;800&family=Source+Sans+3:wght@400;600&display=swap');

/* PRATO CERTO — folha de estilo das três páginas */

:root {
  --papel: #F1F3EC; --branco: #FFF; --tinta: #1B2318;
  --verde: #2F5D3A; --verde-claro: #E3EDDF; --milho: #E3A81F;
  --pedra: #6E766A; --linha: #D3D8CC;
  --titulo: 'Archivo', 'Arial Narrow', sans-serif;
  --texto: 'Source Sans 3', Arial, sans-serif;
  --largura: 1120px; --raio: 4px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--texto); font-size: 16px; line-height: 1.6;
  color: var(--tinta); background-color: var(--papel);
}

h1, h2, h3, legend, .valor strong, .numero {
  font-family: var(--titulo); letter-spacing: -.01em; line-height: 1.15;
}

img { display: block; max-width: 100%; }
a { color: var(--verde); }

a:focus-visible, button:focus-visible, input:focus-visible,
select:focus-visible, textarea:focus-visible,
#grupo-ingredientes input:focus-visible + label {
  outline: 3px solid var(--milho); outline-offset: 2px;
}

/* ---------- Cabeçalho ---------- */

#topo {
  display: flex; align-items: center; gap: 1.5rem;
  max-width: var(--largura); margin: 0 auto; padding: 1rem 1.5rem;
}

#marca {
  display: flex; align-items: center; gap: .7rem;
  text-decoration: none; color: var(--tinta);
}

#marca img { width: 34px; height: 34px; }
#marca h1 { font-size: 1.35rem; font-weight: 800; }

#busca-topo { display: flex; flex: 1; max-width: 420px; }

/* Rótulo apenas para leitores de tela */
#busca-topo label {
  position: absolute; width: 1px; height: 1px;
  overflow: hidden; clip-path: inset(50%);
}

#campo-busca {
  flex: 1; font-family: inherit; font-size: .9rem; padding: .55rem .8rem;
  border: 1px solid var(--linha); border-right: none;
  border-radius: var(--raio) 0 0 var(--raio); background-color: var(--branco);
}

#busca-topo button {
  font-family: inherit; font-size: .9rem; padding: 0 1rem;
  border: 1px solid var(--linha); border-radius: 0 var(--raio) var(--raio) 0;
  background-color: var(--verde-claro); color: var(--verde); cursor: pointer;
}

#menu-principal ul { display: flex; gap: 1.4rem; list-style: none; }

#menu-principal a {
  font-size: .92rem; text-decoration: none;
  color: var(--pedra); padding-bottom: 3px;
}

#menu-principal a:hover { color: var(--verde); }

#menu-principal a[aria-current="page"] {
  color: var(--tinta); border-bottom: 2px solid var(--milho);
}

/* ---------- Estrutura geral ---------- */

main { max-width: var(--largura); margin: 0 auto; padding: 0 1.5rem 3rem; }

.botao {
  display: inline-block; font-family: var(--texto);
  font-size: .95rem; font-weight: 600; text-decoration: none;
  padding: .65rem 1.4rem; border: none; border-radius: var(--raio);
  background-color: var(--verde); color: var(--branco); cursor: pointer;
}

.botao:hover, #rodape-formulario button:hover { background-color: var(--tinta); }

/* ---------- Apresentação ---------- */

#apresentacao { padding: 3rem 0 2.5rem; border-bottom: 1px solid var(--linha); }

#apresentacao h2 {
  font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; max-width: 16ch;
}

#apresentacao > p {
  max-width: 52ch; margin: 1.1rem 0 1.8rem;
  color: var(--pedra); font-size: 1.05rem;
}

/* Valor na primeira linha da grade, rótulo na segunda */
#numeros {
  display: grid; grid-template-columns: repeat(3, max-content);
  gap: .2rem 3.5rem; margin-top: 2.5rem;
  padding-top: 1.5rem; border-top: 1px solid var(--linha);
}

#numeros dd:nth-of-type(1) { grid-area: 1/1; }
#numeros dt:nth-of-type(1) { grid-area: 2/1; }
#numeros dd:nth-of-type(2) { grid-area: 1/2; }
#numeros dt:nth-of-type(2) { grid-area: 2/2; }
#numeros dd:nth-of-type(3) { grid-area: 1/3; }
#numeros dt:nth-of-type(3) { grid-area: 2/3; }

#numeros dd {
  font-family: var(--titulo); font-size: 1.5rem;
  font-weight: 600; font-variant-numeric: tabular-nums;
}

#numeros dt { font-size: .85rem; color: var(--pedra); }

/* Receita da semana, ao lado do título */
#apresentacao {
  display: grid; grid-template-columns: 1fr 400px;
  column-gap: 3rem; align-items: start;
}

#apresentacao h2, #apresentacao > p, #apresentacao > .botao, #numeros { grid-column: 1; }
#apresentacao > .botao { justify-self: start; }

#destaque {
  grid-column: 2; grid-row: 1 / 4;
  padding: .9rem; border: 1px solid var(--linha);
  border-radius: var(--raio); background-color: var(--branco);
}

#destaque figure {
  aspect-ratio: 16/9; overflow: hidden; margin-bottom: .9rem;
  border-radius: var(--raio); background-color: var(--verde-claro);
}

#destaque figure img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
}

.etiqueta {
  font-size: .7rem; font-weight: 600; letter-spacing: .08em;
  text-transform: uppercase; color: var(--milho); margin-bottom: .2rem;
}

#destaque h3 { font-family: var(--titulo); font-size: 1.3rem; margin-bottom: .9rem; }

/* ---------- Filtros ---------- */

#area-receitas {
  display: grid; grid-template-columns: 260px 1fr;
  gap: 2.5rem; padding-top: 2.5rem;
}

#filtros h2 {
  font-size: 1.05rem; padding-bottom: .7rem; border-bottom: 2px solid var(--tinta);
}

#filtros fieldset {
  border: none; padding: 1.4rem 0; border-bottom: 1px solid var(--linha);
}

#filtros legend, #form-receita legend {
  font-size: .8rem; font-weight: 600; color: var(--pedra); margin-bottom: .8rem;
}

/* A caixa de seleção fica escondida e o rótulo vira a etiqueta clicável */
#grupo-ingredientes { display: flex; flex-wrap: wrap; gap: .45rem; }
#grupo-ingredientes legend { margin-bottom: 0; }
#grupo-ingredientes p { margin: 0; }
#grupo-ingredientes input { position: absolute; opacity: 0; pointer-events: none; }

#grupo-ingredientes label {
  display: inline-block; font-size: .85rem; padding: .35rem .85rem;
  border: 1px solid var(--linha); border-radius: 999px;
  background-color: var(--branco); cursor: pointer;
}

#grupo-ingredientes label:hover { border-color: var(--verde); }

#grupo-ingredientes input:checked + label {
  background-color: var(--verde); border-color: var(--verde); color: var(--branco);
}

#grupo-custo label { display: block; font-size: .9rem; margin-bottom: .6rem; }
#valor-custo { font-weight: 600; font-variant-numeric: tabular-nums; }
#custo-maximo { width: 100%; accent-color: var(--verde); }

#grupo-tempo p, #grupo-refeicao p {
  display: flex; align-items: center; gap: .55rem;
  font-size: .9rem; padding: .2rem 0;
}

#grupo-tempo input, #grupo-refeicao input {
  accent-color: var(--verde); width: 15px; height: 15px;
}

#limpar-filtros {
  width: 100%; font-family: inherit; font-size: .9rem;
  margin-top: 1.2rem; padding: .6rem;
  border: 1px solid var(--linha); border-radius: var(--raio);
  background-color: transparent; color: var(--pedra); cursor: pointer;
}

#limpar-filtros:hover { border-color: var(--tinta); color: var(--tinta); }

/* ---------- Resultados ---------- */

#cabecalho-resultados {
  display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
  padding-bottom: .7rem; border-bottom: 2px solid var(--tinta);
}

#cabecalho-resultados h2 { font-size: 1.25rem; }
#cabecalho-resultados p { font-size: .88rem; color: var(--pedra); }

#ordenacao { display: flex; gap: .5rem; list-style: none; margin: 1.2rem 0 1.5rem; }

#ordenacao button {
  font-family: inherit; font-size: .85rem; padding: .35rem .9rem;
  border: 1px solid var(--linha); border-radius: 999px;
  background-color: transparent; color: var(--pedra); cursor: pointer;
}

#ordenacao button[aria-pressed="true"] {
  background-color: var(--branco); border-color: var(--tinta);
  color: var(--tinta); font-weight: 600;
}

#lista-receitas, #lista-ingredientes, .selos { list-style: none; }
#lista-receitas > li + li { margin-top: 1rem; }

.receita {
  display: grid; grid-template-columns: 130px 1fr 150px;
  gap: 1.3rem; align-items: center; padding: 1rem;
  border: 1px solid var(--linha); border-radius: var(--raio);
  background-color: var(--branco);
}

.receita figure {
  aspect-ratio: 4/3; overflow: hidden;
  border-radius: var(--raio); background-color: var(--verde-claro);
}

.receita figure img { width: 100%; height: 100%; object-fit: cover; }

.descricao h3 { font-size: 1.15rem; margin-bottom: .3rem; }
.descricao > p { font-size: .92rem; color: var(--pedra); max-width: 60ch; }

.selos { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .7rem; }

.selos li {
  font-size: .75rem; padding: .2rem .6rem; border-radius: var(--raio);
  background-color: var(--verde-claro); color: var(--verde);
}

/* O preço é o destaque visual da listagem */
.valor { text-align: right; }
.valor p { line-height: 1.1; margin-bottom: .7rem; }

.valor strong {
  display: block; font-size: 1.7rem; font-weight: 800;
  font-variant-numeric: tabular-nums; color: var(--verde);
}

.valor small { font-size: .75rem; color: var(--pedra); }

.abrir-receita {
  font-family: inherit; font-size: .88rem; font-weight: 600;
  width: 100%; padding: .5rem .8rem;
  border: 1px solid var(--verde); border-radius: var(--raio);
  background-color: transparent; color: var(--verde); cursor: pointer;
}

.abrir-receita:hover, #contador-porcoes button:hover {
  background-color: var(--verde); color: var(--branco);
}

/* ---------- Pop-up da receita ---------- */

#painel-receita {
  width: min(880px, 92vw); max-height: 88vh; overflow-y: auto;
  margin: auto; padding: 0; border: none; border-radius: 6px;
  background-color: var(--branco); color: var(--tinta);
}

#painel-receita::backdrop { background-color: rgba(27, 35, 24, .55); }

#painel-receita article {
  display: grid; grid-template-columns: 1fr 260px;
  gap: 1.8rem; padding: 1.6rem 1.8rem 2rem;
}

#cabecalho-receita {
  grid-column: 1/-1; display: flex; align-items: center;
  justify-content: space-between; gap: 1rem;
  padding-bottom: .9rem; border-bottom: 2px solid var(--tinta);
}

#cabecalho-receita h2 { font-size: 1.5rem; }

#fechar-receita {
  font-size: 1.3rem; line-height: 1; width: 32px; height: 32px;
  border: 1px solid var(--linha); border-radius: var(--raio);
  background-color: transparent; color: var(--pedra); cursor: pointer;
}

#fechar-receita:hover { border-color: var(--tinta); color: var(--tinta); }

#preparo figure { margin-bottom: 1.2rem; }

#preparo figure img {
  width: 100%; aspect-ratio: 16/9; object-fit: cover;
  border-radius: var(--raio); background-color: var(--verde-claro);
}

#preparo figcaption { font-size: .8rem; color: var(--pedra); margin-top: .4rem; }

#preparo h3, #lateral-receita h3, #ods h3 { font-size: .95rem; margin-bottom: .6rem; }
#preparo ol { padding-left: 1.1rem; }

#preparo li, #lista-ingredientes li {
  font-size: .92rem; padding: .4rem 0; border-bottom: 1px solid var(--linha);
}

#calculadora {
  padding: 1.1rem; border-radius: var(--raio); background-color: var(--verde-claro);
}

#contador-porcoes { display: flex; align-items: center; gap: .8rem; margin-bottom: 1rem; }

#contador-porcoes button {
  font-size: 1.1rem; line-height: 1; width: 32px; height: 32px;
  border: 1px solid var(--verde); border-radius: var(--raio);
  background-color: var(--branco); color: var(--verde); cursor: pointer;
}

#porcoes {
  font-family: var(--titulo); font-size: 1.4rem; font-weight: 600;
  font-variant-numeric: tabular-nums; min-width: 2ch; text-align: center;
}

#custos {
  display: grid; grid-template-columns: 1fr auto; gap: .35rem 1rem;
  font-size: .9rem; padding-top: .8rem; border-top: 1px solid var(--linha);
}

#custos dt { color: var(--pedra); }
#custos dd { font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }

#ingredientes { margin-top: 1.4rem; }
#lista-ingredientes li { display: flex; justify-content: space-between; gap: 1rem; }
#lista-ingredientes data { font-variant-numeric: tabular-nums; color: var(--pedra); }

/* ---------- Página sobre o projeto ---------- */

#como-funciona { padding: 3rem 0 2.5rem; }

#como-funciona h2, #texto-projeto h2, #cabecalho-envio h2 {
  font-size: 1.8rem; margin-bottom: 1.5rem;
}

#como-funciona ol {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; list-style: none;
}

#como-funciona article { padding-top: 1rem; border-top: 2px solid var(--tinta); }

.numero { font-size: 1.6rem; font-weight: 600; color: var(--milho); margin-bottom: .4rem; }
#como-funciona h3 { font-size: 1.05rem; margin-bottom: .4rem; }
#como-funciona article p:last-child { font-size: .92rem; color: var(--pedra); }

#projeto {
  display: grid; grid-template-columns: 1fr 340px; gap: 3rem; align-items: start;
  padding: 2.5rem 0 1rem; border-top: 1px solid var(--linha);
}

#texto-projeto p { max-width: 62ch; margin-bottom: 1rem; }
#texto-projeto .botao { margin-top: .6rem; }

#ods h3 { padding-bottom: .6rem; margin-bottom: 1rem; border-bottom: 2px solid var(--tinta); }

#ods dt {
  font-family: var(--titulo); font-size: .95rem;
  font-weight: 600; color: var(--verde);
}

#ods dd {
  font-size: .9rem; color: var(--pedra);
  padding-bottom: .9rem; margin-bottom: .9rem; border-bottom: 1px solid var(--linha);
}

#ods dd:last-of-type { border-bottom: none; }

/* ---------- Página de envio de receita ---------- */

#enviar { max-width: 680px; padding: 3rem 0 1rem; }
#cabecalho-envio h2 { margin-bottom: 0; }
#cabecalho-envio p { color: var(--pedra); margin: .5rem 0 2rem; max-width: 58ch; }

#form-receita fieldset { border: none; padding-bottom: 1.5rem; }
#form-receita p { margin-bottom: 1rem; }
#form-receita label { display: block; font-size: .88rem; font-weight: 600; margin-bottom: .35rem; }

#form-receita input[type="text"], #form-receita input[type="email"],
#form-receita select, #form-receita textarea {
  width: 100%; font-family: inherit; font-size: .95rem; padding: .6rem .75rem;
  border: 1px solid var(--linha); border-radius: var(--raio);
  background-color: var(--branco); color: var(--tinta);
}

#form-receita textarea { resize: vertical; }

#dados-autor, #dados-receita {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.2rem;
}

#dados-autor legend, #dados-receita legend, #campo-descricao { grid-column: 1/-1; }

#rodape-formulario {
  display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  padding-top: 1.2rem; border-top: 1px solid var(--linha);
}

#rodape-formulario p {
  display: flex; align-items: center; gap: .5rem; margin: 0; font-size: .88rem;
}

#rodape-formulario label { font-weight: 400; margin: 0; }
#rodape-formulario input { accent-color: var(--verde); width: 16px; height: 16px; }

#rodape-formulario button {
  font-family: inherit; font-size: .95rem; font-weight: 600;
  padding: .65rem 1.6rem; border: none; border-radius: var(--raio);
  background-color: var(--verde); color: var(--branco); cursor: pointer;
}

#retorno-formulario { margin-top: 1rem; font-size: .9rem; color: var(--verde); }

/* ---------- Rodapé ---------- */

#rodape {
  display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  max-width: var(--largura); margin: 0 auto; padding: 1.5rem;
  border-top: 1px solid var(--linha); font-size: .85rem; color: var(--pedra);
}

/* ---------- Telas menores ---------- */

@media (max-width: 900px) {
  #topo { flex-wrap: wrap; }
  #busca-topo { order: 3; max-width: none; width: 100%; }

  #apresentacao, #area-receitas, #projeto,
  #painel-receita article, #como-funciona ol {
    grid-template-columns: 1fr; gap: 1.8rem;
  }

  #destaque { grid-column: 1; grid-row: auto; }

  .receita { grid-template-columns: 100px 1fr; }

  .valor {
    grid-column: 1/-1; display: flex; align-items: center;
    justify-content: space-between; text-align: left;
  }

  .valor strong { font-size: 1.4rem; }
  .abrir-receita { width: auto; }

  #dados-autor, #dados-receita, #rodape, #rodape-formulario {
    grid-template-columns: 1fr; flex-direction: column; align-items: flex-start;
  }
}

/* ---------- Celular ---------- */

@media (max-width: 600px) {
  main { padding: 0 1rem 2rem; }

  /* Cabeçalho e menu centralizados */
  #topo { justify-content: center; text-align: center; }
  #menu-principal ul { flex-wrap: wrap; justify-content: center; gap: 1rem; }

  /* Receita da semana ocupando a largura toda */
  #destaque { padding: 1rem; text-align: center; }
  #destaque figure { aspect-ratio: 3/2; }
  #destaque h3 { font-size: 1.2rem; }
  #destaque .abrir-receita { width: 100%; }

  /* Cabeçalho dos resultados centralizado */
  #cabecalho-resultados {
    flex-direction: column; align-items: center;
    gap: .2rem; text-align: center;
  }

  #ordenacao { flex-wrap: wrap; justify-content: center; }

  /* Cada receita vira um card empilhado e centralizado */
  .receita { grid-template-columns: 1fr; gap: .9rem; text-align: center; padding: 1rem; }
  .receita figure { aspect-ratio: 3/2; }
  .descricao > p { max-width: none; }
  .selos { justify-content: center; }

  .valor {
    flex-direction: column; gap: .7rem; text-align: center;
    margin-top: .2rem; padding-top: .9rem; border-top: 1px solid var(--linha);
  }

  .valor p { margin: 0; }
  .abrir-receita { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
